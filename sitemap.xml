---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/publications.html' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/cv/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/blog/' | absolute_url | xml_escape }}</loc></url>
  {% for post in site.blog %}
  <url><loc>{{ post.url | absolute_url | xml_escape }}</loc></url>
  {% endfor %}
</urlset>
